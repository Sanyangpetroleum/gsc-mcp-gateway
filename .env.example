# Public HTTPS origin with no trailing slash, for example https://gsc-mcp-gateway.vercel.app
PUBLIC_BASE_URL=

# Client -> MCP OAuth boundary
MCP_TOKEN_SIGNING_SECRET=
MCP_ADMIN_PASSWORD=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MCP -> Google Search Console. Preferred production: keyless Vercel OIDC.
# Never disable org policies to obtain a JSON private key.
# GSC_AUTH_MODE=vercel_oidc
# GCP_PROJECT_NUMBER=
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-gsc
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# GCP_SERVICE_ACCOUNT_EMAIL=
#
# Legacy deployments only; do not create a new key if blocked by policy.
# GSC_AUTH_MODE=service_account_json
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Local development only. Never enable on a remote deployment.
ALLOW_IN_MEMORY_OAUTH=

# Optional, DISABLED by default. Do not activate without explicit Google
# IAM/Search Console permission approval and restricted property allowlist.
GSC_SITEMAP_WRITE_ENABLED=false
# GSC_SITEMAP_WRITE_PROPERTIES=sc-domain:example.com
# MCP_WRITE_ADMIN_PASSWORD=
#
# Preferred for the existing Vercel OIDC deployment: separate KEYLESS writer
# service account, same bounded provider, no JSON private key or reader scope change.
# GSC_SITEMAP_WRITE_AUTH_MODE=vercel_oidc
# GCP_SITEMAP_WRITE_SERVICE_ACCOUNT_EMAIL=gsc-mcp-writer@example-project.iam.gserviceaccount.com
#
# Legacy writer only; not recommended when Google enforces key-creation policy.
# GSC_SITEMAP_WRITE_AUTH_MODE=service_account_json
# GSC_SITEMAP_WRITE_SERVICE_ACCOUNT_JSON=

# Optional machine-to-machine GSC Sitemap notification, OFF by default.
# Only trust signed GitHub OIDC from the exact Sanyang production deployment.
GSC_SITEMAP_AUTO_SUBMIT_ENABLED=false
# GSC_AUTOSYNC_GITHUB_REPOSITORY=Sanyangpetroleum/sanyangpetroleum
# GSC_AUTOSYNC_GITHUB_REPOSITORY_ID=1325430708
# GSC_AUTOSYNC_GITHUB_WORKFLOW_REF=Sanyangpetroleum/sanyangpetroleum/.github/workflows/cloudflare-production.yml@refs/heads/main
# GSC_AUTOSYNC_PROPERTY=sc-domain:sanyangpetroleum.com
# GSC_AUTOSYNC_SITEMAP_URL=https://sanyangpetroleum.com/sitemap.xml
